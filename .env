# ============================================================================
# Deriv Synthetic Indices Scanner — environment configuration
# Copy this file to ".env" and fill in your own values.
# Every var below is optional except the Telegram pair (without them,
# signals are only logged to the console, not delivered).
# ============================================================================

# ---- Telegram ---------------------------------------------------------
# Create a bot with @BotFather to get a token, and message @userinfobot
# (or your bot itself) to find your numeric chat id.
TELEGRAM_BOT_TOKEN=8743986007:AAENkLUWg3mKEMfOGRbcEXDusgLVm9mLyHU
TELEGRAM_CHAT_ID=1242803632

# ---- Deriv connection ---------------------------------------------------
# Public demo app_id, fine for unauthenticated market data. Register your
# own at https://api.deriv.com if you want a dedicated one.
DERIV_APP_ID=1089

# ---- Server ---------------------------------------------------------------
# Port the health-check HTTP server binds to (Railway/Render set this
# automatically — leave blank to use their injected value).
PORT=3000

# ---- Watchlist --------------------------------------------------------
# Comma-separated Deriv symbol codes. Leave blank to use the default:
# R_50, 1HZ50V, R_75, 1HZ75V, 1HZ90V, R_100, 1HZ100V
WATCHLIST_SYMBOLS=

# ---- Timeframes ---------------------------------------------------------
# One of: 15m, 30m, 1h
TREND_TIMEFRAME=1h
ENTRY_TIMEFRAME=15m

# ---- Trend Engine (Trend Score) --------------------------------------
EMA20_LEN=20
EMA50_LEN=50
EMA200_LEN=200
ADX_PERIOD=14
ADX_STRENGTH_THRESHOLD=25
SLOPE_LOOKBACK_BARS=5
SLOPE_EPSILON_MULTIPLIER=0.0001

# Signed Trend Score (-5..+5) cutoffs -> bias bucket
SCORE_STRONG_BULLISH_MIN=4
SCORE_BULLISH_MIN=2
SCORE_MIXED_MIN=-1
SCORE_BEARISH_MIN=-3

# Minimum candles buffered before the trend can be scored
MIN_CANDLES=210

# ---- Entry Engine (No-Wick + Retest) -----------------------------------
# "range" = wick tolerance as % of candle's high-low range
# "body"  = wick tolerance as % of candle's body size
WICK_TOLERANCE_MODE=range
WICK_TOLERANCE_PERCENT=3
WICK_TOLERANCE_BODY_PERCENT=15

# How many completed candles a Watching setup stays alive for before expiring
COUNTDOWN_LENGTH=10

# ---- Scanner ------------------------------------------------------------
# How often (ms) the scan loop re-evaluates every watched symbol
SCAN_INTERVAL_MS=2000
